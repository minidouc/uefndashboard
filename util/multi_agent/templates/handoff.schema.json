{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "uefn.handoff.v1",
  "title": "UEFN Multi-Agent Handoff Contract v1",
  "description": "Contrat de passage entre agents du studio UEFN. Output-only (black box), plafonne a 4000 tokens. Adaptation maison derivee des White Papers Google (WP3 p.18/34/45/46).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "handoff_id",
    "from",
    "to",
    "artifact",
    "summary_short",
    "payload",
    "acceptance"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "uefn.handoff.v1"
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^H-[A-Z]+-[0-9]{3,}$",
      "description": "Identifiant unique, trace dans le log de trajectoire."
    },
    "from": {
      "type": "string",
      "description": "Role emetteur (ex: Level_Designer)."
    },
    "to": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Role(s) destinataire(s)."
    },
    "artifact": {
      "type": "string",
      "description": "Nom du livrable produit (ex: 03_grid.json)."
    },
    "mission_ref": {
      "type": "string",
      "description": "Rattachement a la mission du Producer."
    },
    "summary_short": {
      "type": "string",
      "maxLength": 200,
      "description": "Seul champ relu mot a mot par le Producer."
    },
    "payload": {
      "description": "Livrable brut, atomique. Aucune prose de raisonnement.",
      "type": ["object", "array"]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "z_floor": { "type": "number" },
        "z_ceiling": { "type": "number" },
        "must_preserve": { "type": "array", "items": { "type": "string" } },
        "forbidden": { "type": "array", "items": { "type": "string" } }
      }
    },
    "golden_example_ref": {
      "type": "string",
      "description": "Chemin vers l'exemple few-shot / in-context distillation."
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Criteres cochables par un validateur Python, jamais par un LLM."
    },
    "next_step_hint": {
      "type": "string",
      "description": "Instruction courte pour le destinataire."
    },
    "context_budget_tokens": {
      "type": "integer",
      "maximum": 4000,
      "default": 4000,
      "description": "[adaptation maison] Plafond du handoff."
    }
  }
}
