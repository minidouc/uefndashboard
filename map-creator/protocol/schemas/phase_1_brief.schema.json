{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map-creator/phase_1_brief.schema.json",
  "title": "Phase 1 — Brief Verrouillé",
  "type": "object",
  "required": ["project_slug", "pitch", "core_promise", "scope_in", "scope_out", "agent_assumptions", "locked"],
  "properties": {
    "project_slug": { "type": "string" },
    "pitch": { "type": "string", "minLength": 10 },
    "core_promise": { "type": "string", "minLength": 10 },
    "scope_in": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "scope_out": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "clarifications": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["question", "chosen_option"],
        "properties": {
          "question": { "type": "string" },
          "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string" } },
          "chosen_option": { "type": "string" }
        }
      }
    },
    "agent_assumptions": {
      "type": "array",
      "description": "Tout ce que le directeur créatif a décidé seul est explicitement marqué ici",
      "items": { "type": "string" }
    },
    "locked": { "type": "boolean" },
    "human_citation": { "type": ["string", "null"] }
  }
}
